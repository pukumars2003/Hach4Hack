# Copy to server/.env (or the repo root .env) and adjust per host.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_formation
JWT_SECRET=change-me-before-deploying
CORS_ORIGIN=*

# Postgres pool size. Keep it below the server's max_connections, minus the
# dedicated LISTEN connection, the superuser-reserved slots, and any seed/test
# clients. 20 fits a free-tier Postgres; raise it on a dedicated host after the
# pool sweep in docs/LOAD_TEST_REPORT.md.
PG_POOL_MAX=20