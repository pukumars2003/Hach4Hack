{
  "name": "race-proof-team-formation",
  "version": "1.0.0",
  "description": "Production-grade, race-proof team formation service for 50k users under extreme concurrency",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "test": "npm run test --workspace=server",
    "test:race": "npm run test:race --workspace=server",
    "test:chaos": "npm run test:chaos --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "seed": "npm run seed --workspace=server",
    "load-test": "tsx scripts/benchmark.ts 100 10"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

